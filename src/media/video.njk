---
layout: base.html
title: Video
---

<div style="
  display: flex;
  justify-content: center;
  padding-top: 2rem;
  padding-bottom: 3rem;
  ">
  <div style="
    width: min(90%, 65rem);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    ">

    {% for video in videos -%}
    <iframe allowfullscreen allow="autoplay" type="text/html" height="200" width="300" data-kind="VIDEO" src="{{ video | replace('youtu.be', 'www.youtube.com/embed') }}?wmode=transparent&amp;enablejsapi=1&amp;rel=0" frameborder="0" loading="lazy"></iframe>
    {% endfor %}

  </div>
</div>
